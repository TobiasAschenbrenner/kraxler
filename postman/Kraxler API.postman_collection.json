{
  "info": {
    "_postman_id": "d1295b09-66e8-4eb3-a82a-1cb236ba1885",
    "name": "Kraxler API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Liveness",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"API is alive\", () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().status).to.eql(\"ok\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "Readiness",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"API and database are ready\", () => {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql(\"ready\");",
                  "  pm.expect(body.dependencies.database).to.eql(\"up\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ready",
              "host": ["{{baseUrl}}"],
              "path": ["ready"]
            }
          }
        }
      ]
    },
    {
      "name": "Areas",
      "item": [
        {
          "name": "List areas in map bounds",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Returns areas for the visible map\", () => {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data).to.be.an(\"array\");",
                  "  pm.expect(body.meta.count).to.eql(body.data.length);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/areas?bbox={{bbox}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "areas"],
              "query": [
                {
                  "key": "bbox",
                  "value": "{{bbox}}"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Routes",
      "item": [
        {
          "name": "List routes for area",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Returns filtered climbing routes\", () => {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data).to.be.an(\"array\");",
                  "  pm.expect(body.meta.count).to.eql(body.data.length);",
                  "  if (body.data.length > 0) {",
                  "    pm.collectionVariables.set(\"routeId\", body.data[0].id);",
                  "  }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/areas/{{areaId}}/routes?discipline={{discipline}}&gradeSystem={{gradeSystem}}&gradeMin={{gradeMin}}&gradeMax={{gradeMax}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "areas", "{{areaId}}", "routes"],
              "query": [
                {
                  "key": "discipline",
                  "value": "{{discipline}}"
                },
                {
                  "key": "gradeSystem",
                  "value": "{{gradeSystem}}"
                },
                {
                  "key": "gradeMin",
                  "value": "{{gradeMin}}"
                },
                {
                  "key": "gradeMax",
                  "value": "{{gradeMax}}"
                },
                {
                  "key": "style",
                  "value": "{{style}}",
                  "disabled": true
                },
                {
                  "key": "lengthMin",
                  "value": "{{lengthMin}}",
                  "disabled": true
                },
                {
                  "key": "lengthMax",
                  "value": "{{lengthMax}}",
                  "disabled": true
                },
                {
                  "key": "pitchesMin",
                  "value": "{{pitchesMin}}",
                  "disabled": true
                },
                {
                  "key": "pitchesMax",
                  "value": "{{pitchesMax}}",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Get route details",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Returns the selected climbing route\", () => {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data.id).to.eql(pm.collectionVariables.get(\"routeId\"));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/routes/{{routeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "routes", "{{routeId}}"]
            }
          }
        }
      ]
    }
  ],
